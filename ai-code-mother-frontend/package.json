{
  "name": "ai-code-mother-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import ./tests/register.mjs --test tests/*.test.mjs",
    "dev": "node scripts/dev.ts",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "openapi2ts": "openapi2ts",
    "build-only": "vite build",
    "build:preview": "node scripts/build-preview.ts",
    "type-check": "vue-tsc --build",
    "lint": "npm run lint:check",
    "lint:oxlint": "oxlint src tests scripts vite*.ts eslint.config.ts openapi2ts.config.ts",
    "lint:eslint": "eslint . --no-fix --no-cache",
    "format": "prettier --write src/ tests/ scripts/",
    "lint:check": "run-s lint:oxlint lint:eslint lint:architecture",
    "lint:architecture": "node scripts/check-architecture.mjs",
    "lint:fix": "oxlint src tests --fix && eslint src tests --fix",
    "preview:gateway": "node scripts/preview-server.ts",
    "check": "run-s type-check lint:check test build-only build:preview"
  },
  "dependencies": {
    "ant-design-vue": "^4.2.6",
    "axios": "^1.20.0",
    "dompurify": "^3.3.0",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "@ant-design/icons-vue": "^7.0.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@types/markdown-it": "^14.1.2",
    "@umijs/openapi": "^1.14.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
